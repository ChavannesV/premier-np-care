# No environment variables are required for local browsing and content editing.
# npm run dev defaults to local file storage. To set up GitHub mode locally:
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github

# Optional repository override (default is the current npCare GitHub repository).
NEXT_PUBLIC_KEYSTATIC_REPO=supertrens/premier-np-care

# Production: create the Keystatic GitHub App locally, then set these in Vercel.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional for local development; required for real contact email delivery.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Phone and booking link are now edited in /admin, not environment variables.
# Never set NEXT_PUBLIC_KEYSTATIC_STORAGE=local on a deployed environment.
